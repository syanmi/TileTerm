<Window x:Class="TileTerm.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:local="clr-namespace:TileTerm"
        Title="TileTerm" Height="650" Width="1000" Background="#FF1E1E1E"
        WindowStyle="None" ResizeMode="CanResize">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="34" ResizeBorderThickness="4" GlassFrameThickness="0" CornerRadius="0" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="TitleBarButtonBase" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FF3F3F3F" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="TitleBarButton" TargetType="Button" BasedOn="{StaticResource TitleBarButtonBase}" />

        <!-- Minimize/maximize/close: fixed-width like a normal app's caption buttons, full title-bar height. -->
        <Style x:Key="WindowControlButton" TargetType="Button" BasedOn="{StaticResource TitleBarButtonBase}">
            <Setter Property="Width" Value="46" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
        </Style>
        <Style x:Key="TitleBarCloseButton" TargetType="Button" BasedOn="{StaticResource WindowControlButton}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FFE81123" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="34" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Custom title bar: replaces the OS chrome so the pane controls can live in it. -->
        <Grid Grid.Row="0" Background="#FF1A1A1A">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="&#9638;" Foreground="DodgerBlue" FontSize="14"
                       Width="34" VerticalAlignment="Center" HorizontalAlignment="Center" />

            <Button x:Name="SplitRightButton" Grid.Column="1" Style="{StaticResource TitleBarButton}"
                    AutomationProperties.Name="アクティブなタイルを右に分割"
                    shell:WindowChrome.IsHitTestVisibleInChrome="True" />
            <Button x:Name="SplitDownButton" Grid.Column="2" Style="{StaticResource TitleBarButton}"
                    AutomationProperties.Name="アクティブなタイルを下に分割"
                    shell:WindowChrome.IsHitTestVisibleInChrome="True" />
            <Button x:Name="CloseTileButton" Grid.Column="3" Style="{StaticResource TitleBarButton}"
                    ToolTip="アクティブなタイルを閉じる" AutomationProperties.Name="アクティブなタイルを閉じる"
                    shell:WindowChrome.IsHitTestVisibleInChrome="True" />
            <Button x:Name="SettingsButton" Grid.Column="4" Style="{StaticResource TitleBarButton}"
                    ToolTip="設定" AutomationProperties.Name="設定"
                    shell:WindowChrome.IsHitTestVisibleInChrome="True" />

            <StackPanel x:Name="FavoritesPanel" Grid.Column="5" Orientation="Horizontal"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True" />

            <TextBlock Grid.Column="6" Text="TileTerm" Foreground="Gray" FontSize="11"
                       VerticalAlignment="Center" Margin="10,0,0,0" IsHitTestVisible="False" />

            <Button x:Name="MinimizeButton" Grid.Column="7" Style="{StaticResource WindowControlButton}"
                    ToolTip="最小化" AutomationProperties.Name="最小化" shell:WindowChrome.IsHitTestVisibleInChrome="True" />
            <Button x:Name="MaximizeButton" Grid.Column="8" Style="{StaticResource WindowControlButton}"
                    ToolTip="最大化" AutomationProperties.Name="最大化" shell:WindowChrome.IsHitTestVisibleInChrome="True" />
            <Button x:Name="CloseWindowButton" Grid.Column="9" Style="{StaticResource TitleBarCloseButton}"
                    ToolTip="閉じる" AutomationProperties.Name="閉じる" shell:WindowChrome.IsHitTestVisibleInChrome="True" />
        </Grid>

        <ContentControl x:Name="PaneHost" Grid.Row="1" />
    </Grid>
</Window>
