<Window x:Class="TileTerm.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:local="clr-namespace:TileTerm"
        Title="TileTerm" Height="650" Width="1000" Background="#FF1E1E1E"
        WindowStyle="None" ResizeMode="CanResize">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="32" ResizeBorderThickness="4" GlassFrameThickness="0" CornerRadius="0" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="TitleBarButtonBase" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="Gainsboro" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FF3F3F3F" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="TitleBarButton" TargetType="Button" BasedOn="{StaticResource TitleBarButtonBase}" />
        <Style x:Key="TitleBarCloseButton" TargetType="Button" BasedOn="{StaticResource TitleBarButtonBase}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FFE81123" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="32" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Custom title bar: replaces the OS chrome so the pane controls can live in it. -->
        <Grid Grid.Row="0" Background="#FF1A1A1A">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="&#9638;" Foreground="DodgerBlue" FontSize="14"
                       Width="32" VerticalAlignment="Center" HorizontalAlignment="Center" />

            <Button x:Name="SplitRightButton" Grid.Column="1" Content="分割→" Style="{StaticResource TitleBarButton}"
                    ToolTip="アクティブなタイルを右に分割" shell:WindowChrome.IsHitTestVisibleInChrome="True" />
            <Button x:Name="SplitDownButton" Grid.Column="2" Content="分割↓" Style="{StaticResource TitleBarButton}"
                    ToolTip="アクティブなタイルを下に分割" shell:WindowChrome.IsHitTestVisibleInChrome="True" />
            <Button x:Name="CloseTileButton" Grid.Column="3" Content="タイルを閉じる" Style="{StaticResource TitleBarButton}"
                    ToolTip="アクティブなタイルを閉じる" shell:WindowChrome.IsHitTestVisibleInChrome="True" />
            <Button x:Name="SettingsButton" Grid.Column="4" Content="設定..." Style="{StaticResource TitleBarButton}"
                    shell:WindowChrome.IsHitTestVisibleInChrome="True" />

            <TextBlock Grid.Column="5" Text="TileTerm" Foreground="Gray" FontSize="11"
                       VerticalAlignment="Center" Margin="10,0,0,0" IsHitTestVisible="False" />

            <Button x:Name="MinimizeButton" Grid.Column="6" Content="_" Style="{StaticResource TitleBarButton}"
                    shell:WindowChrome.IsHitTestVisibleInChrome="True" />
            <Button x:Name="MaximizeButton" Grid.Column="7" Content="□" Style="{StaticResource TitleBarButton}"
                    shell:WindowChrome.IsHitTestVisibleInChrome="True" />
            <Button x:Name="CloseWindowButton" Grid.Column="8" Content="✕" Style="{StaticResource TitleBarCloseButton}"
                    shell:WindowChrome.IsHitTestVisibleInChrome="True" />
        </Grid>

        <ContentControl x:Name="PaneHost" Grid.Row="1" />
    </Grid>
</Window>
