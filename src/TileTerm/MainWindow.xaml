<Window x:Class="TileTerm.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TileTerm"
        mc:Ignorable="d"
        Title="TileTerm" Height="650" Width="1000" Background="Black">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#FF1A1A1A">
            <StackPanel Orientation="Horizontal" Margin="4">
                <Button x:Name="SettingsButton" Content="設定..." Padding="8,3,8,3" Margin="2" />
            </StackPanel>
        </Border>

        <ContentControl x:Name="PaneHost" Grid.Row="1" />
    </Grid>
</Window>
