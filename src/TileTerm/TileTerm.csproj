<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <Product>TileTerm</Product>
    <!-- The one place the version lives. AssemblyVersion and FileVersion are derived from it by the SDK. -->
    <Version>0.1.3</Version>
    <ApplicationIcon>Assets\TileTerm.ico</ApplicationIcon>
    <!-- Program.Main (not the XAML-generated one) starts the app: Velopack must run first, see Program.cs. -->
    <StartupObject>TileTerm.Program</StartupObject>
  </PropertyGroup>

  <ItemGroup>
    <ApplicationDefinition Remove="App.xaml" />
    <Page Include="App.xaml" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\TileTerm.ico" />
    <Resource Include="Assets\TileTerm-titlebar.png" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Porta.Pty" Version="1.0.7" />
    <PackageReference Include="Velopack" Version="1.2.0" />
    <PackageReference Include="XTerm.NET" Version="1.2.0" />
  </ItemGroup>

</Project>
